DATABASE_URL="postgresql://demo:demo@localhost:5433/mar_demo?schema=public"
PORT=3000
# Stockage S3 (local : S3Mock via docker compose ; prod : bucket Railway)
S3_ENDPOINT=http://localhost:9090
S3_REGION=us-east-1
S3_BUCKET=mar-demo
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=local
S3_FORCE_PATH_STYLE=true
# Prod seulement : domaines autorisés à uploader dans le bucket (CORS), séparés par des virgules
S3_CORS_ORIGINS=
# Emails promus ADMIN (séparés par des virgules)
ADMIN_EMAILS=admin@example.com
